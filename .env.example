# ---------------------------------------------------------------------------
# Wintora environment variables
# Copy to .env.local for development. NEVER commit real values.
# Variables prefixed NEXT_PUBLIC_ are exposed to the browser: put nothing
# sensitive behind that prefix.
# ---------------------------------------------------------------------------

# --- Application ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development
# Global incident kill switch (see docs/SECURITY.md "Safe mode").
SAFE_MODE=false

# --- Supabase (Postgres + Auth + Storage) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role bypasses Row Level Security. Server-only. Never ship to a client
# bundle, never place in a NEXT_PUBLIC_ variable, never log.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_URL=
# Private storage bucket for user-uploaded documents.
SUPABASE_DOCUMENTS_BUCKET=user-documents

# --- Payments: Paddle (Merchant of Record) ---
# Paddle is the LEGAL SELLER of every subscription. They collect the payment,
# calculate and remit sales tax / VAT / GST, and decide refunds under their own
# buyer terms. Wintora provides the software. See docs/BILLING.md.
#
# Stripe is not used: it is invite-only in India, where this service is
# operated from.
PAYMENT_PROVIDER=paddle
PADDLE_ENVIRONMENT=sandbox

# Server-only. Never in a NEXT_PUBLIC_ variable, never in a client bundle.
PADDLE_API_KEY=
# From the notification destination in the Paddle dashboard. The webhook
# endpoint fails closed without it, so checkout would succeed and entitlements
# would never arrive.
PADDLE_WEBHOOK_SECRET=
# Paddle's own SDKs default to 5 seconds, which drops legitimate events on a
# slow network hop. The real replay defence is the unique (provider, event_id)
# constraint, so this is defence in depth and is set wide enough to be safe.
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300

# Public by design, like a publishable key. Used by Paddle.js in the browser.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# --- Paddle price ids, per plan and per currency ---
# Filled in automatically by `npm run paddle:seed -- --apply`, which writes them
# into the plans and plan_prices tables. The database is the source of truth;
# these exist only for reference. See docs/BILLING.md section 2.
PADDLE_PRICE_ESSENTIAL_USD=
PADDLE_PRICE_ESSENTIAL_CAD=
PADDLE_PRICE_PLUS_USD=
PADDLE_PRICE_PLUS_CAD=
PADDLE_PRICE_PRO_USD=
PADDLE_PRICE_PRO_CAD=

# --- AI provider (abstraction layer; see src/lib/ai) ---
#
# The model does ONE job: rephrasing a finding the deterministic rule engine has
# already produced. It cannot create, suppress or alter a finding. Every failure
# path falls back to the deterministic sentence, so running with no AI at all is
# a supported configuration, not a degraded one.
#
# openrouter | anthropic | none
AI_PROVIDER=openrouter

# OpenRouter brokers many upstream providers behind one OpenAI-compatible API,
# including free endpoints. Get a key at openrouter.ai/settings/keys.
OPENROUTER_API_KEY=

# Free endpoints are withdrawn and re-added without notice, so treat these as
# starting points, not guarantees:
#   npm run ai:models   lists what is free today
#   npm run ai:smoke    sends a synthetic finding through the real pipeline and
#                       reports which models pass the output validator
# Both tiers point at the same model today. Measured on 2026-09-10: of 19 free
# text models, only 3 accept the no-data-collection routing constraint, and this
# is the one of those that passed the output validator reliably and quickly. With
# free endpoints there is no cost difference between tiers, so the routing has
# nothing to optimise for yet; it stays in place for when a paid model is set.
AI_MODEL_BASIC=nex-agi/nex-n2.5-mini:free
AI_MODEL_ADVANCED=nex-agi/nex-n2.5-mini:free

# Most endpoints are free because prompts may be retained or used for training.
# Left false, Wintora asks OpenRouter to route only to providers that do not
# collect prompt data, and fails the call rather than routing to one that does.
# Setting this true is a privacy decision that belongs in the privacy notice
# before it is used with real customer documents.
AI_ALLOW_PROMPT_TRAINING=false

# Whether a prompt may include raw text from the customer's document. Off by
# default: the finding and its evidence are enough to rephrase from, and the
# excerpt is the one field that could carry something redaction missed.
AI_SEND_DOCUMENT_EXCERPT=false

# Only needed if AI_PROVIDER=anthropic. Paid; kept so the broker is reversible.
ANTHROPIC_API_KEY=

# Hard ceiling so a runaway job cannot destroy plan margin.
AI_MAX_INPUT_CHARS=120000

# --- Document reading ---
#
# PDFs with a text layer (most portal downloads) are read in-process with no
# third party. Photographs and scans need OCR. Leave OCR_PROVIDER=none and
# photo uploads are stored but not read; the customer types the figures in.
#
# azure = Azure Document Intelligence, prebuilt invoice model. Free tier is
# 500 pages/month. Create a "Document Intelligence" resource in the Azure
# portal, copy its endpoint and one of its keys. It becomes a subprocessor;
# docs/PRIVACY.md names it.
OCR_PROVIDER=none
AZURE_DI_ENDPOINT=
AZURE_DI_KEY=

# --- Upload scanning ---
#
# structural = verify the file type from its bytes and reject PDFs carrying
# scripts, launch actions, embedded files or encryption. In-process, free, no
# third party sees the file. This is NOT signature antivirus; see LIMITATIONS.
# none = every upload stays PENDING and cannot be read. Fail-closed default.
MALWARE_SCAN_PROVIDER=structural
MALWARE_SCAN_API_KEY=

# --- Transactional email ---
EMAIL_PROVIDER=none
EMAIL_API_KEY=
EMAIL_FROM="Wintora <info@wintora.online>"

# --- Privacy-conscious analytics (marketing site only) ---
NEXT_PUBLIC_ANALYTICS_DOMAIN=
NEXT_PUBLIC_ANALYTICS_SCRIPT_URL=

# --- Cron / scheduled jobs authentication ---
# Any long random string you generate yourself. The cron routes compare it in
# constant time and fail closed when it is unset, so an unconfigured secret
# means a closed endpoint rather than an open one.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

# --- Log and abuse-window hashing ---
# Keys the opaque user reference in logs and the salted IP hash used for rate
# limiting, so a log file is not a list of who uses the service. Generate the
# same way as CRON_SECRET, and use a DIFFERENT value.
# Required in production: without it the rate limiter falls back to a known
# development salt, which makes IP hashes guessable.
# Rotating it breaks correlation with older logs. That is the intended trade.
LOG_HASH_SECRET=
